{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "442d7d9f984548bf9e3cf27f5412f261",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "ToonLighting (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 500.0,
            "y": -1191.0,
            "width": 205.0,
            "height": 365.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "3ec07f95e51f4438a77e93ca9ea5667f"
        },
        {
            "m_Id": "93d345df2ce04eeea7e67c12de450091"
        },
        {
            "m_Id": "5474a512211044e0baa31769a38f9f63"
        },
        {
            "m_Id": "68c1af7d064c4507a8587c25aac6cae1"
        },
        {
            "m_Id": "5b4f3a5b77fe426498f6ae3b213ac626"
        },
        {
            "m_Id": "9046afde30e24723a3be24865931a586"
        },
        {
            "m_Id": "99adcc898d4d44a0898c2af3bb98090a"
        },
        {
            "m_Id": "44dbb79f69a644a48dae5c9f7f2afe47"
        },
        {
            "m_Id": "17aa24c340fd4e9097ade6a878dbb756"
        },
        {
            "m_Id": "57afbc8a49d74ac09b3688e76d9e3b5c"
        },
        {
            "m_Id": "87dff348b7134b8eb10dccd08acfbff8"
        },
        {
            "m_Id": "2f52da96bd014af0a3cc617609d59341"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "ToonLighting",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float3 N = normalize(Normal);\nfloat3 V = normalize(ViewDir);\nLight mainLight = GetMainLight();\nfloat3 L = normalize(mainLight.direction);\nfloat3 H = normalize(V + L);\n\nfloat NL = dot(N, L) * 0.5 + 0.5;\nfloat NV = dot(N, V);\nfloat NH = dot(N, H);\n\nfloat shadeFactor = smoothstep(ShadeThreshold - ShadeSoftness, ShadeThreshold + ShadeSoftness, NL);\n\nfloat glossFactor = smoothstep(\n    (1 - GlossThreshold * 0.05) - GlossSoftness * 0.05,\n    (1 - GlossThreshold * 0.05) + GlossSoftness * 0.05,\n    NH\n);\n\nfloat shadow = mainLight.shadowAttenuation;\n\nfloat edge = smoothstep(\n    (1 - EdgeThreshold) - EdgeSoftness * 0.5,\n    (1 - EdgeThreshold) + EdgeSoftness * 0.5,\n    0.5 - NV\n);\n\nfloat3 diffuse = mainLight.color * BaseColor.rgb * shadeFactor * shadow;\nfloat3 specular = GlossTint.rgb * shadow * shadeFactor * glossFactor;\nfloat3 ambient = edge * EdgeColor.rgb + SampleSH(N) * BaseColor.rgb;\n\nOut = diffuse + ambient + specular;\n"
}

